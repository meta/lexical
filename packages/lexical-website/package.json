{
  "name": "@lexical/website",
  "version": "0.53.0",
  "private": true,
  "scripts": {
    "docusaurus": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus",
    "start": "pnpm -C ../.. run build && pnpm -C ../.. run build:doc-examples && cross-env IGNORE_PEER_DEPENDENCIES=react TYPEDOC_WATCH=true docusaurus start",
    "build": "pnpm run tsc && pnpm -C ../.. run build && pnpm -C ../.. run build:dev-examples && pnpm -C ../.. run build:doc-examples && cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus build",
    "tsc": "tsc -p tsconfig.json",
    "test-examples": "node --test scripts/example-source.test.mjs && node scripts/check-homepage-examples.mjs && node scripts/check-getting-started-examples.mjs",
    "swizzle": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus swizzle",
    "deploy": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus deploy",
    "clear": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus clear",
    "serve": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus serve",
    "write-translations": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus write-translations",
    "write-heading-ids": "cross-env IGNORE_PEER_DEPENDENCIES=react docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/plugin-content-pages": "^3.10.2",
    "@docusaurus/plugin-google-gtag": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/plugin-svgr": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@huggingface/transformers": "^4.2.0",
    "@lexical/extension": "workspace:*",
    "@lexical/hashtag": "workspace:*",
    "@lexical/history": "workspace:*",
    "@lexical/list": "workspace:*",
    "@lexical/overflow": "workspace:*",
    "@lexical/plain-text": "workspace:*",
    "@lexical/react": "workspace:*",
    "@lexical/rich-text": "workspace:*",
    "@lexical/selection": "workspace:*",
    "@lexical/utils": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.2.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "emoji-datasource-facebook": "15.1.2",
    "fs-extra": "^11.3.4",
    "lexical": "workspace:*",
    "mermaid": "^11.16.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@tailwindcss/postcss": "^4.3.3",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
