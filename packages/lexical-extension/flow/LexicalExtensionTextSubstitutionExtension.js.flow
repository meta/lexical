import type {LexicalExtension} from 'lexical';
import type {NamedSignalsOutput} from '@lexical/extension/namedSignals';

declare export var DEFAULT_TEXT_SUBSTITUTIONS: Readonly<{
  [string]: string,
}>;

export type TextSubstitutionConfig = {
  disabled: boolean,
  substitutions: Readonly<{[string]: string}>,
};

declare export var TextSubstitutionExtension: LexicalExtension<
  TextSubstitutionConfig,
  '@lexical/extension/TextSubstitution',
  NamedSignalsOutput<TextSubstitutionConfig>,
  void,
>;
