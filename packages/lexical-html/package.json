{
  "name": "@lexical/html",
  "description": "This package contains HTML helpers and functionality for Lexical.",
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "html"
  ],
  "license": "MIT",
  "version": "0.53.0",
  "types": "./dist/typescript-too-old.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/lexical.git",
    "directory": "packages/lexical-html"
  },
  "dependencies": {
    "@lexical/extension": "workspace:*",
    "@lexical/internal": "workspace:*",
    "@lexical/selection": "workspace:*",
    "@lexical/utils": "workspace:*",
    "lexical": "workspace:*"
  },
  "module": "./dist/LexicalHtml.js",
  "sideEffects": false,
  "exports": {
    "./BlockIdHTMLExtension": {
      "source": "./src/BlockIdHTMLExtension.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/BlockIdHTMLExtension.d.ts",
      "development": "./dist/LexicalHtmlBlockIdHTMLExtension.dev.js",
      "production": "./dist/LexicalHtmlBlockIdHTMLExtension.prod.js",
      "default": "./dist/LexicalHtmlBlockIdHTMLExtension.js"
    },
    "./BlockIdHTMLExtension.js": {
      "source": "./src/BlockIdHTMLExtension.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/BlockIdHTMLExtension.d.ts",
      "development": "./dist/LexicalHtmlBlockIdHTMLExtension.dev.js",
      "production": "./dist/LexicalHtmlBlockIdHTMLExtension.prod.js",
      "default": "./dist/LexicalHtmlBlockIdHTMLExtension.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types@<5.2": "./dist/typescript-too-old.d.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/LexicalHtml.dev.js",
      "production": "./dist/LexicalHtml.prod.js",
      "default": "./dist/LexicalHtml.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__bench__",
    "!src/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts",
    "!src/**/*.bench.tsx",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/typescript-too-old.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module"
}
