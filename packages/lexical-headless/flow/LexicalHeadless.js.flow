import type {
  LexicalEditor,
  LexicalNode,
  EditorState,
  EditorThemeClasses,
  ExtensionConfigBase,
  LexicalExtension,
} from 'lexical';

declare export var HeadlessExtension: LexicalExtension<
  ExtensionConfigBase,
  '@lexical/headless/Headless',
  void,
  void,
>;

declare export function createHeadlessEditor(editorConfig?: {
  editorState?: EditorState,
  namespace?: string,
  nodes?: ReadonlyArray<Class<LexicalNode>>,
  onError?: (error: Error) => void,
  parentEditor?: LexicalEditor,
  editable?: boolean,
  theme?: EditorThemeClasses,
}): LexicalEditor;
