export type RefCountedRegistry<Key, Options = void> = {
  register: (key: Key, options?: Options) => () => void,
  dispose: () => void,
};
declare export function createRefCountedRegistry<Key, Options = void>(
  activate: (key: Key, options: Options | void) => () => void,
