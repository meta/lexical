   * TypeScript overload was removed in v0.53.0; this Flow overload is kept
   * until the Flow call sites that pass a type argument are migrated. Call
   * this method without a type argument and narrow the result with a type
   * guard instead.
   */
  getParentOrThrow<T extends ElementNode>(): T;
  getTopLevelElement(): DecoratorNode<unknown> | ElementNode | null;
  getTopLevelElementOrThrow(): DecoratorNode<unknown> | ElementNode;
  getParents(): ElementNode[];
  /**
   * @deprecated The type parameter is an unchecked and unsafe cast. The
   * TypeScript overload was removed in v0.53.0; this Flow overload is kept
   * until the Flow call sites that pass a type argument are migrated. Call
   * this method without a type argument and narrow the result with a type
   * guard instead.
