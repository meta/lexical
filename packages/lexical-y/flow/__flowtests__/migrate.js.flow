// Checked by `pnpm run flow` (not shipped): the migration entries.

import type {
  YLayoutInfo,
  YLayoutMigration,
  YMigrationResult,
} from '@lexical/y/migrate';
import type {YSessionVerdict} from '@lexical/y/server';
import type {Doc, Node} from '@y/y';

import {MIN_LAYOUT, SEED_LAYOUT, onYMigrationEpoch} from '@lexical/y';
import {
  getYLayoutInfo,
  migrateYState,
  YMigrationError,
} from '@lexical/y/migrate';
import step1to2 from '@lexical/y/migrate/1to2';
import {
  checkYSession,
  createYDoc,
  generationOf,
  prepareYRoom,
  SEED_LAYOUT as SERVER_SEED_LAYOUT,
} from '@lexical/y/server';

declare const stored: Uint8Array;
const serverSeed: number = SERVER_SEED_LAYOUT;
declare const container: Node;

// A step built by hand: every member, checkAfter included.
const handmade: YLayoutMigration = {
  checkAfter: (c: Node) => [],
  from: 1,
  id: 'handmade',
  // Returning nothing is a step's ordinary shape.
  migrateContainer: (tr: unknown, c: Node) => {},
  readAfter: (c: Node) => [],
  readBefore: (c: Node) => [],
  revision: 1,
  rewrites: (key: string) => false,
  to: 2,
  v: 1,
};
// $FlowExpectedError[incompatible-type] a step names its contract version
const unversioned: YLayoutMigration = {...handmade, v: undefined};
const problems: ReadonlyArray<string> = handmade.checkAfter(container);
const frozenProblems: ReadonlyArray<string> = step1to2.checkAfter(container);
// $FlowExpectedError[incompatible-type] a step without checkAfter is not a step
const incomplete: YLayoutMigration = {
  from: 1,
  id: 'incomplete',
  migrateContainer: (tr: unknown, c: Node) => ({deleted: 0, written: 0}),
  readAfter: (c: Node) => [],
  readBefore: (c: Node) => [],
  revision: 1,
  rewrites: (key: string) => false,
  to: 2,
  v: 1,
};

const steps: ReadonlyArray<YLayoutMigration> = [step1to2];
const result: YMigrationResult = migrateYState(stored, steps, {gc: true, to: 2});
const update: Uint8Array | null = result.update;
// $FlowExpectedError[incompatible-type] update is null when nothing ran
const always: Uint8Array = result.update;
const error = new YMigrationError('missing-step', 'no step');
// $FlowExpectedError[incompatible-type] codes are a closed set
const bad = new YMigrationError('other', 'no');
const doc = createYDoc(stored);
const generation: string = generationOf(doc, 'incarnation');
const room = prepareYRoom(stored, {incarnation: 'i', steps});
const verdict: YSessionVerdict = checkYSession(
  {
    generation: room.generation,
    hasMigration: false,
    incarnation: 'i',
    inherited: false,
    layouts: [1, 1],
    pristine: false,
    requires: [],
    seedContract: SEED_LAYOUT,
    unreadable: [],
  },
  {
    generation: null,
    layouts: [MIN_LAYOUT, 2],
    material: false,
    seed: SEED_LAYOUT,
    v: 1,
  },
);
if (verdict.verdict === 'admit') {
  const initialize: boolean = verdict.initialize;
}
const stop: () => void = onYMigrationEpoch(doc, epoch => {
  const layout: ?number = epoch?.layout;
});

// The layout state of a root: a fixed status union, details by status.
function layoutOf(doc: Doc): number | null {
  const info: YLayoutInfo = getYLayoutInfo(doc);
  switch (info.status) {
    case 'ready':
      return info.layout;
    case 'unsupported':
      return info.reason === 'requires' ? null : info.layout;
    case 'invalid':
      // $FlowExpectedError[prop-missing] an invalid root has no layout
      void info.layout;
      return null;
    case 'missing':
      return null;
  }
}
