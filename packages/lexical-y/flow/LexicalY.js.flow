import type {
  LexicalEditor,
  LexicalExtension,
  PointType,
  SerializedEditorState,
} from 'lexical';
import {LexicalWarning} from 'lexical';
import type {Doc, Node as YNode, UndoManager} from '@y/y';
import type {ReadonlySignal} from '@lexical/extension';

/**
 * @lexical/y: EXPERIMENTAL Yjs 14 binding (block-marker layout).
 */

declare export var DEFAULT_ROOT_NAME: 'lexical-y';
declare export var LAYOUT_VERSION: number;
declare export var MIN_LAYOUT: number;
declare export var SEED_LAYOUT: number;

export type YBindingStatus = 'pending' | 'active' | 'readonly';

export type ClientIDRange = 'uint53' | 'uint32';

declare export var UNSUPPORTED_LAYOUT_WARNING: '@lexical/y/unsupported-layout';
declare export var UNKNOWN_NODE_TYPES_WARNING: '@lexical/y/unknown-node-types';
declare export var STORAGE_MISMATCH_WARNING: '@lexical/y/storage-mismatch';
declare export var SELF_CHECK_WARNING: '@lexical/y/self-check';
declare export var RECOVERED_READ_WARNING: '@lexical/y/recovered-read';
declare export var RECOVERED_WRITE_WARNING: '@lexical/y/recovered-write';
declare export var NESTED_FALLBACK_WARNING: '@lexical/y/nested-fallback';
declare export var UNSYNCED_VALUE_WARNING: '@lexical/y/unsynced-value';
declare export var UNSUPPORTED_SLOTS_WARNING: '@lexical/y/unsupported-slots';
declare export var UNSUPPORTED_CONFIG_WARNING: '@lexical/y/unsupported-config';
declare export var UNSUPPORTED_EDIT_WARNING: '@lexical/y/unsupported-edit';
declare export var UNSUPPORTED_SCHEMA_WARNING: '@lexical/y/unsupported-schema';
// The codes this version reports; YWarningCode is open (a later version may
// add codes: keep a fallback).
export type YKnownWarningCode =
  | typeof UNSUPPORTED_LAYOUT_WARNING
  | typeof UNKNOWN_NODE_TYPES_WARNING
  | typeof STORAGE_MISMATCH_WARNING
  | typeof SELF_CHECK_WARNING
  | typeof RECOVERED_READ_WARNING
  | typeof RECOVERED_WRITE_WARNING
  | typeof NESTED_FALLBACK_WARNING
  | typeof UNSYNCED_VALUE_WARNING
  | typeof UNSUPPORTED_SLOTS_WARNING
  | typeof UNSUPPORTED_CONFIG_WARNING
  | typeof UNSUPPORTED_EDIT_WARNING
  | typeof UNSUPPORTED_SCHEMA_WARNING;
export type YWarningCode = string;
// What any code may carry besides its own variants (permanent fallback).
export type YOtherWarningData = {
  readonly reason: 'other',
  readonly detailCode: string,
  readonly details?: unknown,
};

export type YUnsupportedLayoutData =
  | {readonly reason: 'newer', readonly found: number, readonly supported: number}
  | {readonly reason: 'malformed', readonly key: string, readonly found: unknown, readonly supported: number}
  | {readonly reason: 'missing' | 'removed', readonly supported: number}
  | {readonly reason: 'older', readonly found: number, readonly min: number, readonly supported: number}
  | {readonly reason: 'requires', readonly features: ReadonlyArray<string>, readonly supported: number}
  | {readonly reason: 'legacy-roots', readonly roots: ReadonlyArray<string>, readonly supported: number};
export type YUnsupportedSchemaData =
  | {readonly reason: 'newer', readonly found: number, readonly supported: number}
  | {readonly reason: 'malformed', readonly key: string, readonly found: unknown, readonly supported: number};
export type YStoredAs = {
  readonly kind: 'line' | 'format' | 'group' | 'nested',
  readonly by?: ReadonlyArray<string>,
};
export type YStorageMismatchData =
  | {readonly reason: 'malformed', readonly type: string, readonly key: string, readonly found: unknown}
  | {
      readonly reason: 'declaration-changed',
      readonly type: string,
      readonly stored: YStoredAs,
      readonly declared: YStoredAs,
    };
export type YUnknownNodeTypesData = {
  readonly reason: 'unregistered' | 'malformed-slot',
  readonly types: ReadonlyArray<string>,
};
export type YUnreadableContentData = {
  readonly reason: 'unreadable',
  readonly types: ReadonlyArray<string>,
  readonly error: unknown,
};
export type YUnsupportedSlotsData = {
  readonly reason: 'stored-host' | 'root',
  readonly types: ReadonlyArray<string>,
};
export type YUnsupportedConfigData =
  | {readonly reason: 'repair-transforms', readonly options: ReadonlyArray<string>}
  | {readonly reason: 'cleanup-formatting'};
export type YUnsupportedEditData = {readonly reason: 'read-only'};
export type YSelfCheckData = {
  readonly reason: 'local' | 'remote',
  readonly problems: ReadonlyArray<string>,
};
export type YRecoveredReadData = {
  readonly reason: 'remote-change' | 'reread',
  readonly error: unknown,
};
export type YRecoveredWriteData = {readonly reason: 'local-change', readonly error: unknown};
export type YNestedFallbackReason =
  | 'merge-override'
  | 'inline-slots'
  | 'inline-incomplete-schema'
  | 'type-name'
  | 'merge-incomplete-schema'
  | 'merge-slots'
  | 'group-children'
  | 'group-state-merge'
  | 'group-incomplete-schema'
  | 'undeclared-properties';
export type YNestedFallbackData =
  | {readonly reason: 'merge-override', readonly type: string, readonly method: string}
  | {
      readonly reason: 'undeclared-properties',
      readonly type: string,
      readonly properties: ReadonlyArray<string>,
    }
  | {
      readonly reason:
        | 'inline-slots'
        | 'inline-incomplete-schema'
        | 'type-name'
        | 'merge-incomplete-schema'
        | 'merge-slots'
        | 'group-children'
        | 'group-state-merge'
        | 'group-incomplete-schema',
      readonly type: string,
    };
export type YUnsyncedValueData = {readonly reason: 'not-json', readonly property: string};

declare export class YWarningOf<out C extends string, out D>
  extends LexicalWarning
{
  readonly code: C;
  readonly data: D;
}
// Open: any code, `data` unknown until narrowed with isYWarning(value, code).
export type YWarning = YWarningOf<string, unknown>;
// The `data` of each known code.
type YWarningDataByCode = {
  '@lexical/y/unsupported-layout': YUnsupportedLayoutData | YOtherWarningData,
  '@lexical/y/unknown-node-types': YUnknownNodeTypesData | YUnreadableContentData | YOtherWarningData,
  '@lexical/y/storage-mismatch': YStorageMismatchData | YOtherWarningData,
  '@lexical/y/self-check': YSelfCheckData | YOtherWarningData,
  '@lexical/y/recovered-read': YRecoveredReadData | YOtherWarningData,
  '@lexical/y/recovered-write': YRecoveredWriteData | YOtherWarningData,
  '@lexical/y/nested-fallback': YNestedFallbackData | YOtherWarningData,
  '@lexical/y/unsynced-value': YUnsyncedValueData | YOtherWarningData,
  '@lexical/y/unsupported-slots': YUnsupportedSlotsData | YOtherWarningData,
  '@lexical/y/unsupported-config': YUnsupportedConfigData | YOtherWarningData,
  '@lexical/y/unsupported-edit': YUnsupportedEditData | YOtherWarningData,
  '@lexical/y/unsupported-schema': YUnsupportedSchemaData | YOtherWarningData,
};
// The `data` of a warning whose (known) `code` is `C`.
export type YWarningData<C extends YKnownWarningCode> = YWarningDataByCode[C];
// The warnings this version knows, one member per code (keep a default).
export type YKnownWarning =
  | YWarningOf<typeof UNSUPPORTED_LAYOUT_WARNING, YWarningData<typeof UNSUPPORTED_LAYOUT_WARNING>>
  | YWarningOf<typeof UNKNOWN_NODE_TYPES_WARNING, YWarningData<typeof UNKNOWN_NODE_TYPES_WARNING>>
  | YWarningOf<typeof STORAGE_MISMATCH_WARNING, YWarningData<typeof STORAGE_MISMATCH_WARNING>>
  | YWarningOf<typeof SELF_CHECK_WARNING, YWarningData<typeof SELF_CHECK_WARNING>>
  | YWarningOf<typeof RECOVERED_READ_WARNING, YWarningData<typeof RECOVERED_READ_WARNING>>
  | YWarningOf<typeof RECOVERED_WRITE_WARNING, YWarningData<typeof RECOVERED_WRITE_WARNING>>
  | YWarningOf<typeof NESTED_FALLBACK_WARNING, YWarningData<typeof NESTED_FALLBACK_WARNING>>
  | YWarningOf<typeof UNSYNCED_VALUE_WARNING, YWarningData<typeof UNSYNCED_VALUE_WARNING>>
  | YWarningOf<typeof UNSUPPORTED_SLOTS_WARNING, YWarningData<typeof UNSUPPORTED_SLOTS_WARNING>>
  | YWarningOf<typeof UNSUPPORTED_CONFIG_WARNING, YWarningData<typeof UNSUPPORTED_CONFIG_WARNING>>
  | YWarningOf<typeof UNSUPPORTED_EDIT_WARNING, YWarningData<typeof UNSUPPORTED_EDIT_WARNING>>
  | YWarningOf<typeof UNSUPPORTED_SCHEMA_WARNING, YWarningData<typeof UNSUPPORTED_SCHEMA_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSUPPORTED_LAYOUT_WARNING,
): value is YWarningOf<typeof UNSUPPORTED_LAYOUT_WARNING, YWarningData<typeof UNSUPPORTED_LAYOUT_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNKNOWN_NODE_TYPES_WARNING,
): value is YWarningOf<typeof UNKNOWN_NODE_TYPES_WARNING, YWarningData<typeof UNKNOWN_NODE_TYPES_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof STORAGE_MISMATCH_WARNING,
): value is YWarningOf<typeof STORAGE_MISMATCH_WARNING, YWarningData<typeof STORAGE_MISMATCH_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof SELF_CHECK_WARNING,
): value is YWarningOf<typeof SELF_CHECK_WARNING, YWarningData<typeof SELF_CHECK_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof RECOVERED_READ_WARNING,
): value is YWarningOf<typeof RECOVERED_READ_WARNING, YWarningData<typeof RECOVERED_READ_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof RECOVERED_WRITE_WARNING,
): value is YWarningOf<typeof RECOVERED_WRITE_WARNING, YWarningData<typeof RECOVERED_WRITE_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof NESTED_FALLBACK_WARNING,
): value is YWarningOf<typeof NESTED_FALLBACK_WARNING, YWarningData<typeof NESTED_FALLBACK_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSYNCED_VALUE_WARNING,
): value is YWarningOf<typeof UNSYNCED_VALUE_WARNING, YWarningData<typeof UNSYNCED_VALUE_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSUPPORTED_SLOTS_WARNING,
): value is YWarningOf<typeof UNSUPPORTED_SLOTS_WARNING, YWarningData<typeof UNSUPPORTED_SLOTS_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSUPPORTED_CONFIG_WARNING,
): value is YWarningOf<typeof UNSUPPORTED_CONFIG_WARNING, YWarningData<typeof UNSUPPORTED_CONFIG_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSUPPORTED_EDIT_WARNING,
): value is YWarningOf<typeof UNSUPPORTED_EDIT_WARNING, YWarningData<typeof UNSUPPORTED_EDIT_WARNING>>;
declare export function isYWarning(
  value: unknown,
  code: typeof UNSUPPORTED_SCHEMA_WARNING,
): value is YWarningOf<typeof UNSUPPORTED_SCHEMA_WARNING, YWarningData<typeof UNSUPPORTED_SCHEMA_WARNING>>;
declare export function isYWarning(value: unknown): value is YWarning;

export type YBindingOptions = {
  // Required: the version of the app's document schema, an integer from 1.
  schemaVersion: number,
  root?: YNode,
  captureTimeout?: number | null,
  onStatus?: (status: YBindingStatus) => void,
  selfCheck?: boolean,
  selfCheckSample?: number,
  convert?: boolean,
  clientIDRange?: ClientIDRange,
};

// What a migration records under `lexical-y-epoch` (inexact: readers keep
// fields they do not know). kind: `layout` today; step ids are opaque.
export type YMigrationEpoch = {
  readonly v: 1,
  readonly kind: string,
  readonly layout: number,
  readonly client: number,
  readonly clock: number,
  readonly step: string,
  readonly revision: number,
  readonly schema?: {readonly id: string, readonly version: number, ...},
  ...
};

// Calls `fn` after every listener of a transaction that changed `root`'s
// epoch (a migration) has run: clear app UndoManagers there.
declare export function onYMigrationEpoch(
  doc: Doc,
  fn: (epoch: YMigrationEpoch | null) => void,
  root?: string | YNode,
): () => void;

export type YCursor = {anchor: unknown, focus: unknown};

// A Y.Doc made by createYDoc: Yjs's format cleanup is off from its creation.
declare export opaque type YDoc: Doc;

// The options of new Y.Doc(options), which createYDoc passes on. gcFilter
// is called with the Yjs Item about to be garbage collected (false keeps it).
export type YDocOptions = {
  autoLoad?: boolean,
  collectionid?: string | null,
  gc?: boolean,
  gcFilter?: (item: {
    readonly deleted: boolean,
    readonly id: {readonly client: number, readonly clock: number, ...},
    ...
  }) => boolean,
  guid?: string,
  isSuggestionDoc?: boolean,
  meta?: unknown,
  shouldLoad?: boolean,
};

// The one @y/y version this @lexical/y supports (its exact peer dependency).
declare export var SUPPORTED_YJS_VERSION: string;

declare export var UNSUPPORTED_YJS_ERROR: '@lexical/y/unsupported-yjs';

export type YUnsupportedYjsReason = 'changed-internals' | 'other-copy';

export type YUnsupportedYjsData = {
  readonly supported: string,
  readonly found: ReadonlyArray<string>,
  readonly reason: YUnsupportedYjsReason,
};

// Thrown by createYDoc, the YBinding constructor (so YCollabExtension) and
// the headless helpers when the app's @y/y is not the supported one, before
// anything is written. Fix: install exactly @y/y@<data.supported>, once.
declare export class YUnsupportedYjsError extends Error {
  readonly code: typeof UNSUPPORTED_YJS_ERROR;
  readonly data: YUnsupportedYjsData;
  constructor(data: YUnsupportedYjsData): void;
}

// A Y.Doc for @lexical/y (a client's, a relay's or a server's), with Yjs's
// format cleanup turned off before `state` is applied (when given).
declare export function createYDoc(
  state?: Uint8Array | null,
  options?: YDocOptions,
): YDoc;

declare export class YBinding {
  get editor(): LexicalEditor;
  get doc(): YDoc;
  get root(): YNode;
  get status(): YBindingStatus;
  get pins(): ReadonlyMap<
    string,
    {readonly kind: StorageKind, readonly by?: ReadonlyArray<string>},
  >;
  get undoManager(): UndoManager | null;
  constructor(editor: LexicalEditor, doc: YDoc, options: YBindingOptions): void;
  start(): () => void;
  dispose(): void;
  initialize(): void;
  undo(): boolean;
  redo(): boolean;
  getCursor(): YCursor | null;
  quiesce(): {
    state: Uint8Array,
    draft: {json: SerializedEditorState, differs: boolean},
  };
  $resolveCursor(cursor: YCursor): {anchor: PointType, focus: PointType} | null;
}

export type StorageKind = 'line' | 'format' | 'group' | 'nested';

declare export function describeStorage(
  editor: LexicalEditor,
  // An interface, so that a YBinding (a class instance) is accepted too.
  binding?: interface {
    readonly pins: ReadonlyMap<string, {readonly kind: StorageKind, ...}>,
  },
): {[type: string]: StorageKind | 'text'};

export type YCollabConfig = {
  doc: YDoc | null,
  // Required (the extension throws without one): an integer from 1.
  schemaVersion: number,
  root: YNode | null,
  synced: boolean,
  captureTimeout: number | null,
  clientIDRange: ClientIDRange,
  selfCheck: boolean | null,
  selfCheckSample: number | null,
  convert: boolean,
};

declare export var YCollabExtension: LexicalExtension<
  YCollabConfig,
  '@lexical/y/Collab',
  {binding: YBinding, status: ReadonlySignal<YBindingStatus>},
  unknown,
>;
