[ignore]
**/scripts/**
**/build/**
**/__tests__/**
**/__bench__/**
**/dist/**
**/npm/**
**/.tempUserDataDir/**
**/node_modules/**
**/libdefs/**

[include]
./packages/

[lints]
untyped-type-import=error
deprecated-type=error

[options]
server.max_workers=4
exact_by_default=true
component_syntax=true

